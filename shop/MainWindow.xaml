<Window x:Class="shop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shop Shoes"
        FontFamily="Calibri"
        Background="White"
        Height="500"
        Width="950"
        MinHeight="350"
        MinWidth="850">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#D2F6E7">
            <StackPanel Orientation="Horizontal" Margin="10,5">
                <Image Source="/Image/logo.png"
                       Height="55"
                       Stretch="Uniform"/>
                <TextBlock Text="Shop Shoes"
                           FontSize="24"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="15,0,0,0"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,15,0">
                <TextBlock x:Name="user"
                           HorizontalAlignment="Right"
                           FontSize="16"
                           Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="btnCart"
                            Content="Корзина"
                            Width="100"
                            Margin="0,0,10,0"
                            Click="btnCart_Click"/>
                    <Button x:Name="btnOrders"
                            Content="Заказы"
                            Width="100"
                            Margin="0,0,10,0"
                            Click="btnOrders_Click"/>
                    <ComboBox x:Name="cbFilter"
                              Width="150"
                              Margin="0,0,10,0"
                              SelectionChanged="cbFilter_SelectionChanged"/>
                    <ComboBox x:Name="cbSort"
                              Width="170"
                              SelectedIndex="0"
                              SelectionChanged="cbSort_SelectionChanged">
                        <ComboBoxItem Content="Без сортировки"/>
                        <ComboBoxItem Content="Цена по возрастанию"/>
                        <ComboBoxItem Content="Цена по убыванию"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid x:Name="searchPanel"
              Grid.Row="1"
              Margin="5,5,5,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left">
                <TextBlock Text="Поиск: "
                           VerticalAlignment="Center"
                           FontSize="14"/>
                <TextBox x:Name="tbSearch"
                         Width="300"
                         Height="26"
                         VerticalContentAlignment="Center"
                         TextChanged="tbSearch_TextChanged"/>
            </StackPanel>
            <Button x:Name="btnDone"
                    Content="Готово"
                    Width="100"
                    Height="26"
                    HorizontalAlignment="Right"
                    Visibility="Collapsed"
                    Click="btnDone_Click"/>
        </Grid>

        <ListBox x:Name="ProductsList"
                 Grid.Row="2"
                 Margin="5"
                 HorizontalContentAlignment="Stretch"
                 SelectionChanged="ProductsList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray"
                            BorderThickness="1"
                            Padding="8"
                            Background="{Binding BackColor}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0"
                                   Source="{Binding Photo}"
                                   Width="100"
                                   Height="100"
                                   Stretch="Uniform"/>

                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Category}"/>
                                <TextBlock Text="{Binding Description}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Structure, StringFormat=Состав: {0}}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Count, StringFormat=В наличии: {0}}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding Price}"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>