<Window x:Class="shop.OrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Состав заказа"
        Icon="/Image/picture.ico"
        FontFamily="Calibri"
        Background="White"
        Height="480"
        Width="800"
        MinHeight="400"
        MinWidth="700"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtHeader"
                   Grid.Row="0"
                   FontSize="18"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <DataGrid x:Name="dgItems"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар (производство | наименование)" Binding="{Binding ProductText}" Width="*"/>
                <DataGridTextColumn Header="Размер" Binding="{Binding SizeName}" Width="65"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="60"/>
                <DataGridTextColumn Header="Цена за ед." Binding="{Binding PriceText}" Width="110"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding SumText}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="txtTotal"
                   Grid.Row="2"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,8,0,0"/>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <StackPanel x:Name="adminPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left">
                <TextBlock Text="Дата заказа: "
                           VerticalAlignment="Center"/>
                <DatePicker x:Name="dpDate"
                            Width="130"
                            Margin="0,0,10,0"/>
                <Button Content="Сохранить дату"
                        Width="120"
                        Height="28"
                        Margin="0,0,15,0"
                        Click="btnSaveDate_Click"/>
                <Button Content="Удалить позицию"
                        Width="130"
                        Height="28"
                        Click="btnDeleteItem_Click"/>
            </StackPanel>
            <Button Content="Закрыть"
                    Width="100"
                    Height="28"
                    HorizontalAlignment="Right"
                    Click="btnClose_Click"/>
        </Grid>
    </Grid>
</Window>