<Window x:Class="shop.CartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ"
        Icon="/Image/picture.ico"
        FontFamily="Calibri"
        Background="White"
        Height="600"
        Width="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20">
        <StackPanel x:Name="staffPanel">
            <TextBlock Text="Клиент"/>
            <ComboBox x:Name="cbClient" Margin="0,3,0,10"/>
            <TextBlock Text="Дата заказа"/>
            <DatePicker x:Name="dpDate" Margin="0,3,0,10"/>
        </StackPanel>

        <Button x:Name="btnAddProduct"
                Content="Добавить товар из каталога"
                Height="30"
                Click="btnAddProduct_Click"/>

        <TextBlock Text="Состав заказа"
                   FontWeight="Bold"
                   Margin="0,15,0,5"/>
        <ListBox x:Name="lbCart" Height="150"/>
        <Button Content="Убрать выбранную позицию"
                Height="26"
                Margin="0,5,0,0"
                Click="btnRemove_Click"/>
        <TextBlock x:Name="txtTotal"
                   FontWeight="Bold"
                   Margin="0,10,0,10"/>

        <Button Content="Оформить заказ"
                Height="32"
                Background="#70B2AF"
                Click="btnConfirm_Click"/>
        <Button Content="Отказаться от заказа"
                Height="32"
                Margin="0,8,0,0"
                Click="btnCancel_Click"/>
        <Button Content="Назад"
                Height="32"
                Margin="0,8,0,0"
                Click="btnBack_Click"/>
    </StackPanel>
</Window>