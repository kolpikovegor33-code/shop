<Window x:Class="shop.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказы"
        Icon="/Image/picture.ico"
        FontFamily="Calibri"
        Background="White"
        Height="520"
        Width="720"
        MinHeight="400"
        MinWidth="600"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtTitle"
                   Grid.Row="0"
                   Text="Список заказов"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,8"/>

        <DataGrid x:Name="dgOrders"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding OrderNumber}" Width="50"/>
                <DataGridTextColumn Header="Дата заказа" Binding="{Binding DateText}" Width="110"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding Client}" Width="*"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalText}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,8,0,0">
            <Button Content="Состав заказа"
                    Width="130"
                    Height="30"
                    Margin="0,0,10,0"
                    Click="btnDetails_Click"/>
            <Button x:Name="btnAddOrder"
                    Content="Добавить заказ"
                    Width="130"
                    Height="30"
                    Margin="0,0,10,0"
                    Click="btnAddOrder_Click"/>
            <Button x:Name="btnDeleteOrder"
                    Content="Удалить заказ"
                    Width="130"
                    Height="30"
                    Click="btnDeleteOrder_Click"/>
        </StackPanel>
    </Grid>
</Window>