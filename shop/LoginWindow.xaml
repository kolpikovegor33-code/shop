<Window x:Class="shop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shop Shoes" Height="320" Width="350"
        WindowStartupLocation="CenterScreen"
        FontFamily="Calibri" Background="White">
    <StackPanel Margin="30">
        <TextBlock Text="Авторизация" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <TextBlock Text="Логин"/>
        <TextBox x:Name="tbLogin" Height="28" Margin="0,3,0,10"
                 FontSize="14"/>
        <Button x:Name="btnEnter" Content="Войти" Height="32" Background="#70B2AF" Click="btnEnter_Click"/>
        <Button x:Name="btnGuest" Content="Войти как гость" Height="32" Margin="0,10,0,0" Click="btnGuest_Click"/>
    </StackPanel>
</Window>