<Window x:Class="shop.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар"
        Icon="/Image/picture.ico"
        FontFamily="Calibri"
        Background="White"
        Height="540"
        Width="820"
        MinHeight="480"
        MinWidth="700"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0"
                      Margin="0,0,15,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Image x:Name="imgPhoto"
                       Height="180"
                       Stretch="Uniform"
                       HorizontalAlignment="Left"/>
                <TextBlock x:Name="txtName"
                           FontSize="22"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Margin="0,10,0,5"/>
                <TextBlock x:Name="txtManufacturer" Margin="0,2"/>
                <TextBlock x:Name="txtCategory" Margin="0,2"/>
                <TextBlock x:Name="txtPrice"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,5"/>
                <TextBlock x:Name="txtStructure"
                           TextWrapping="Wrap"
                           Margin="0,2"/>
                <TextBlock x:Name="txtDescription"
                           TextWrapping="Wrap"
                           Margin="0,2"/>
                <TextBlock x:Name="txtSizes"
                           TextWrapping="Wrap"
                           Margin="0,2"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="1">
            <TextBlock Text="Размер"/>
            <ComboBox x:Name="cbSize" Margin="0,3,0,10"/>

            <TextBlock Text="Количество"/>
            <TextBox x:Name="tbQuantity"
                     Text="1"
                     Height="26"
                     VerticalContentAlignment="Center"
                     Margin="0,3,0,15"/>

            <Button Content="Добавить в заказ"
                    Height="32"
                    Background="#70B2AF"
                    Click="btnAdd_Click"/>
            <Button Content="Назад"
                    Height="32"
                    Margin="0,8,0,0"
                    Click="btnBack_Click"/>
        </StackPanel>
    </Grid>
</Window>